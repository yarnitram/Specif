# ---------------------------------------------------------------------------
# Persistent database (Turso / libSQL) — OPTIONAL but REQUIRED for Hostinger
# shared hosting, where the local disk (and any data/terminal.db file) is
# wiped on every redeploy.
#
# When TURSO_DB_URL is set, the app uses Turso (hosted SQLite) so your
# watchlist + strategies persist. When it's NOT set, the app falls back to a
# local node:sqlite file at data/terminal.db (fine for local dev or a VPS).
#
# Get a free database at https://turso.tech, then:
#   turso db show <name>             -> copy the URL (libsql://...)
#   turso db tokens create <name>    -> copy the auth token
# The URL is the "libsql://..." address — NOT the token. Set both on
# Hostinger's app env vars too.
# ---------------------------------------------------------------------------
TURSO_DB_URL=libsql://YOUR_DB.REGION.turso.io
TURSO_DB_TOKEN=YOUR_TURSO_AUTH_TOKEN